# Copy to .env and fill in ONE of these. .env is gitignored - never commit it.
# Free options that are plenty for this: Groq (fast, free) or Google Gemini (generous free tier).
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: raises Socrata throttle limits. Not required - the API works keyless.
BTS_APP_TOKEN=

# Optional: Langfuse tracing. Without these, tracing is a silent no-op and the project
# still runs with zero third-party dependencies. Traces are recorded at the BOUNDARY —
# the scoring engine itself stays pure; see src/airportiq/obs.py.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
